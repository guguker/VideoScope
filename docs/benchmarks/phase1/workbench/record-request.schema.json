{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "properties": {
        "start_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Seconds"
        },
        "end_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Seconds"
        },
        "event_type": {
          "default": "shot",
          "enum": [
            "shot",
            "pass",
            "rebound",
            "turnover",
            "foul",
            "substitution",
            "screen",
            "defense",
            "other",
            "unclear"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "possession_id": {
          "anyOf": [
            {
              "pattern": "^(team|player|possession|event|frame)-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Possession Id"
        },
        "actor_id": {
          "anyOf": [
            {
              "pattern": "^(team|player|possession|event|frame)-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "receiver_id": {
          "anyOf": [
            {
              "pattern": "^(team|player|possession|event|frame)-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receiver Id"
        },
        "passer_id": {
          "anyOf": [
            {
              "pattern": "^(team|player|possession|event|frame)-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passer Id"
        },
        "last_pass_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Pass Seconds"
        },
        "incoming_player_id": {
          "anyOf": [
            {
              "pattern": "^(team|player|possession|event|frame)-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incoming Player Id"
        },
        "outgoing_player_id": {
          "anyOf": [
            {
              "pattern": "^(team|player|possession|event|frame)-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outgoing Player Id"
        },
        "shot_type": {
          "anyOf": [
            {
              "enum": [
                "two",
                "three",
                "free_throw",
                "non_shot",
                "unclear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Type"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "made",
                "miss",
                "not_applicable",
                "unclear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "scoring_decision": {
          "anyOf": [
            {
              "enum": [
                "counted",
                "not_counted",
                "not_applicable",
                "unclear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scoring Decision"
        },
        "play_context": {
          "anyOf": [
            {
              "enum": [
                "in_play",
                "foul_on_shot",
                "after_whistle",
                "other_dead_ball",
                "not_applicable",
                "unclear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Play Context"
        },
        "presentation": {
          "anyOf": [
            {
              "enum": [
                "live",
                "replay",
                "unclear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Presentation"
        },
        "boundary_status": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "too_short",
                "unclear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary Status"
        },
        "defensive_action": {
          "anyOf": [
            {
              "enum": [
                "on_ball",
                "help",
                "switch",
                "trap",
                "zone",
                "man_to_man",
                "unclear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Defensive Action"
        },
        "notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "Event",
      "type": "object"
    },
    "EventRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "workspace_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workspace Revision",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Source Id",
          "type": "string"
        },
        "record_id": {
          "pattern": "^(team|player|possession|event|frame)-[0-9a-f]{32}$",
          "title": "Record Id",
          "type": "string"
        },
        "expected_revision": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "status": {
          "enum": [
            "draft",
            "human_reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "archived": {
          "title": "Archived",
          "type": "boolean"
        },
        "kind": {
          "const": "event",
          "title": "Kind",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/Event"
        }
      },
      "required": [
        "schema_version",
        "workspace_revision",
        "source_id",
        "record_id",
        "expected_revision",
        "status",
        "archived",
        "kind",
        "data"
      ],
      "title": "EventRequest",
      "type": "object"
    },
