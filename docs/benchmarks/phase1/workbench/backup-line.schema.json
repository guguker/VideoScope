      },
      "required": [
        "schema_version",
        "workspace_id",
        "title",
        "sources"
      ],
      "title": "PublicWorkspace",
      "type": "object"
    },
    "StoredEvent": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^(team|player|possession|event|frame)-[0-9a-f]{32}$",
          "title": "Record Id",
          "type": "string"
        },
        "revision": {
          "maximum": 1000001,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "source_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "kind": {
          "const": "event",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "human_reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "archived": {
          "title": "Archived",
          "type": "boolean"
        },
        "data": {
          "$ref": "#/$defs/Event"
        },
        "created_at": {
          "maxLength": 40,
          "title": "Created At",
          "type": "string"
