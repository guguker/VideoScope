          "type": "integer"
        },
        "workspace_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Workspace Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/PublicSource"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
