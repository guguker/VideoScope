          "default": "",
          "maxLength": 2000,
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "Possession",
      "type": "object"
    },
    "PublicSource": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "review_allowed": {
          "title": "Review Allowed",
          "type": "boolean"
        },
        "role": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "source_group": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Group",
          "type": "string"
        },
        "training_rights": {
          "const": "unknown",
          "title": "Training Rights",
          "type": "string"
        },
        "media_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Media Url"
        },
        "fps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        }
      },
      "required": [
        "source_id",
        "title",
        "sha256",
        "duration_seconds",
        "byte_size",
        "review_allowed",
        "role",
        "source_group",
        "training_rights",
        "media_url"
      ],
      "title": "PublicSource",
      "type": "object"
