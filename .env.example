# Локальные настройки приложения
VIDEOSCOPE_DATA_DIR=./data
VIDEOSCOPE_MAX_UPLOAD_BYTES=12884901888
VIDEOSCOPE_HOST=127.0.0.1
VIDEOSCOPE_PORT=8765

# Локальный RF-DETR работает без ключа. Для собственных облачных моделей Universe укажите ключ.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=rfdetr-small

# Необязательные настройки ресурсоёмких локальных модулей.
LIGHTHOUSE_ROOT=
LIGHTHOUSE_CHECKPOINT=./data/models/lighthouse/clip_qd_detr_qvhighlight.ckpt
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_LANGUAGE=auto
WHISPER_INITIAL_PROMPT=Точная русская речь. Сохраняй имена, фамилии и названия.
VIDEOSCOPE_TEXT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
VIDEOSCOPE_TEXT_EMBEDDING_DIMENSIONS=768
# Размер 224 используется как быстрый резервный вариант. Для профиля качества выберите 384 и выполните `make index-visual-quality`.
VIDEOSCOPE_SIGLIP_MODEL=google/siglip2-base-patch16-224

# Необязательный GPU-сервис InternVideo 2.5. Локальный поиск работает и без него.
INTERNVIDEO_ENDPOINT=
INTERNVIDEO_API_KEY=
