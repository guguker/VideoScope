# Локальные настройки приложения
VIDEOSCOPE_DATA_DIR=./data
VIDEOSCOPE_MAX_UPLOAD_BYTES=12884901888
VIDEOSCOPE_HOST=127.0.0.1
VIDEOSCOPE_PORT=8765
VIDEOSCOPE_OCR_WORKER_PYTHON=.venv-ocr/bin/python
VIDEOSCOPE_OCR_WORKER_SCRIPT=scripts/paddle-ocr-worker.py

# Hosted Roboflow — отдельная альтернатива локальному vision worker.
# Оба поля должны быть заполнены только для собственной Universe-модели project/version.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=

# SigLIP 2 и локальный RF-DETR работают только в отдельном vision worker.
# Используйте один и тот же отдельный URL-safe токен длиной не менее 32 символов
# в endpoint и worker; незаполненная пара оставляет visual/object этапы отключёнными.
VIDEOSCOPE_VISION_WORKER_ENDPOINT=
VIDEOSCOPE_VISION_WORKER_API_KEY=
VIDEOSCOPE_VISION_WORKER_PORT=8783
VIDEOSCOPE_VISION_WORKER_INPUT_ROOT=./data
VIDEOSCOPE_VISION_WORKER_RFDETR_CHECKPOINT=./data/models/rfdetr/rf-detr-small.pth
VIDEOSCOPE_VISION_DETECTOR_MODEL_ID=rfdetr-small
VIDEOSCOPE_VISION_DETECTOR_CHECKPOINT_SHA256=d81979a9213a2109345158ce9232668df4c1ae52e9b8db3f2ec0a8cbad959b33
VIDEOSCOPE_VISION_WORKER_MINIMUM_CONFIDENCE=0.25
VIDEOSCOPE_VISION_WORKER_TIMEOUT=120

# Lighthouse работает только через отдельный локальный worker. Сгенерируйте
# отдельный URL-safe токен длиной не менее 32 символов для обоих процессов.
LIGHTHOUSE_CHECKPOINT=./data/models/lighthouse/clip_qd_detr_qvhighlight.ckpt
LIGHTHOUSE_CLIP_CHECKPOINT=./data/models/lighthouse/ViT-B-32.pt
LIGHTHOUSE_ENDPOINT=
LIGHTHOUSE_API_KEY=
LIGHTHOUSE_WORKER_PORT=8782
VIDEOSCOPE_LIGHTHOUSE_TIMEOUT=300
# Только аварийный откат; штатно оставьте false.
LIGHTHOUSE_ALLOW_IN_PROCESS=false

# Необязательные настройки остальных ресурсоёмких локальных модулей.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_LANGUAGE=auto
WHISPER_INITIAL_PROMPT=Точная русская речь. Сохраняй имена, фамилии и названия.
VIDEOSCOPE_WHISPER_WORKER_ENDPOINT=
VIDEOSCOPE_WHISPER_WORKER_API_KEY=
VIDEOSCOPE_WHISPER_WORKER_PORT=8784
VIDEOSCOPE_WHISPER_WORKER_INPUT_ROOT=./data/media
VIDEOSCOPE_WHISPER_WORKER_WORK_ROOT=./data/tmp/whisper-worker
VIDEOSCOPE_WHISPER_WORKER_MODEL_REVISION=a4aaeec0636e6fef84abdcbe3544cb2bf7e9f6fb
VIDEOSCOPE_WHISPER_WORKER_TIMEOUT=3600
VIDEOSCOPE_TEXT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
VIDEOSCOPE_TEXT_EMBEDDING_DIMENSIONS=768
# Размер 224 используется по умолчанию. Для профиля качества выберите 384,
# перезапустите vision worker и выполните `make index-visual-quality`.
VIDEOSCOPE_SIGLIP_MODEL=google/siglip2-base-patch16-224
VIDEOSCOPE_VISUAL_INDEX_STEP=1
VIDEOSCOPE_VISUAL_INDEX_MAX_WIDTH=640

# Локальная проверка временных событий и номеров игроков на Apple Metal.
# Qwen запускается отдельным loopback-only worker из `.venv-qwen`.
QWEN_VIDEO_MODEL=mlx-community/Qwen3.5-9B-MLX-4bit
QWEN_VIDEO_ENDPOINT=
QWEN_VIDEO_API_KEY=
QWEN_WORKER_PORT=8781
QWEN_WORKER_MAX_CONCURRENCY=1
VIDEOSCOPE_QWEN_VIDEO_TOP_CANDIDATES=12
VIDEOSCOPE_QWEN_VIDEO_CONTEXT_SECONDS=4
VIDEOSCOPE_QWEN_VIDEO_MIN_CLIP_SECONDS=7
VIDEOSCOPE_QWEN_VIDEO_MAX_CLIP_SECONDS=12
VIDEOSCOPE_QWEN_VIDEO_FRAME_COUNT=12
VIDEOSCOPE_QWEN_VIDEO_FPS=2
VIDEOSCOPE_QWEN_VIDEO_TIMEOUT=180

# Необязательный приватный HTTPS GPU-сервис InternVideo 2.5. Локальный поиск работает и без него.
# При настройке endpoint API key обязателен; не передавайте кадры и bearer-токен по plaintext HTTP.
INTERNVIDEO_ENDPOINT=
INTERNVIDEO_API_KEY=
